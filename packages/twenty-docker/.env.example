# Twenty CRM — Environment Variables
# Copy to packages/twenty-docker/.env and fill in values

# Server
TAG=latest
SERVER_URL=http://localhost:3000

# Database
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=postgres
PG_DATABASE_NAME=default
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432

# Redis
REDIS_URL=redis://redis:6379

# Security — generate random values before deploy
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
FALLBACK_ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
APP_SECRET=CHANGE_ME_APP_SECRET

# Storage (local filesystem)
STORAGE_TYPE=local

# Disable optional features for lightweight deploy
# DISABLE_DB_MIGRATIONS=false
# DISABLE_CRON_JOBS_REGISTRATION=false

# Email (for password reset, etc — optional)
# EMAIL_FROM_ADDRESS=noah@dispatch.ai
# EMAIL_FROM_NAME="Noah"
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
